{
  "name": "perricheno-health",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node test/browser.mjs",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "vendor": "node scripts/vendor.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "morphicons": "^1.7.1",
    "playwright": "^1.55.0",
    "wrangler": "^4.0.0"
  }
}
